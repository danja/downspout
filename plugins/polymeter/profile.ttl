@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:polymeter a trn:PluginProfile ;
    rdfs:label "Polymeter" ;
    rdfs:comment "Four-lane Euclidean MIDI generator with independent coprime lengths, rotations, probabilities, ratchets, accents, and phase drift." ;
    trn:bundleName "polymeter.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/polymeter/> ;
    trn:role trn:MidiGenerator ;
    trn:produces trn:Midi, trn:DrumMidi ;
    trn:requires trn:HostTransport ;
    trn:recommendedBefore dsp:drumkit ;
    trn:parameter [ rdfs:label "Lane 1-4 CA rule" ; trn:symbol "l1_rule, l2_rule, l3_rule, l4_rule" ; trn:range "0-255" ;
                    rdfs:comment "0 keeps the lane Euclidean. 1-255 plays a 1-D cellular automaton (Wolfram rule) seeded from Pulses/Length, one generation per lane cycle, 64-generation loop." ] ;
    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
