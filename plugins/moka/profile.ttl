@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:moka a trn:PluginProfile ;
    rdfs:label "Moka" ;
    rdfs:comment "Polyphonic modal hit-object instrument: xylophone, glockenspiel, woodblock, glass bowl, metal sheet, and tube." ;
    trn:bundleName "moka.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/moka/> ;
    trn:role trn:Instrument ;
    trn:accepts trn:Midi, trn:MelodyMidi, trn:HarmonyMidi ;
    trn:produces trn:Audio ;
    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
