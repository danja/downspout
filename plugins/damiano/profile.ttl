@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:damiano a trn:PluginProfile ;
    rdfs:label "Damiano" ;
    rdfs:comment "Stereo distortion with six modes (soft clip, tanh, fuzz, overdrive, tube, wavefold), optional split left/right processing for a binaural effect, and MIDI CC control of drive and shape per channel via Drift." ;
    trn:bundleName "damiano.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/damiano/> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio, trn:MidiCC ;
    trn:produces trn:Audio .

dsp:damiano trn:hasParameter [
    trn:symbol "mode" ;
    trn:label "Mode" ;
    trn:minimum 0 ; trn:maximum 5 ; trn:default 1 ;
    rdfs:comment "0=Soft 1=Tanh 2=Fuzz 3=Overdrive 4=Tube 5=Wavefold"
], [
    trn:symbol "drive" ;
    trn:label "Drive" ;
    trn:minimum 1.0 ; trn:maximum 10.0 ; trn:default 2.0 ;
    rdfs:comment "Pre-distortion gain; overridden by MIDI CC when CC Drive > 0"
], [
    trn:symbol "tone" ;
    trn:label "Tone" ;
    trn:minimum 0.0 ; trn:maximum 100.0 ; trn:default 50.0 ;
    rdfs:comment "High-shelf tone: 50=flat, 0=darkest, 100=brightest"
], [
    trn:symbol "fold_count" ;
    trn:label "Fold Count" ;
    trn:minimum 1 ; trn:maximum 8 ; trn:default 2 ;
    rdfs:comment "Wavefold mode only: number of triangle fold iterations"
], [
    trn:symbol "mix" ;
    trn:label "Mix" ;
    trn:minimum 0.0 ; trn:maximum 100.0 ; trn:default 100.0 ;
    rdfs:comment "Dry/wet blend percentage"
], [
    trn:symbol "output_gain" ;
    trn:label "Output Gain" ;
    trn:minimum -24.0 ; trn:maximum 24.0 ; trn:default 0.0 ;
    rdfs:comment "Post-distortion gain in dB"
], [
    trn:symbol "cc_drive" ;
    trn:label "CC Drive" ;
    trn:minimum 0 ; trn:maximum 127 ; trn:default 0 ;
    rdfs:comment "MIDI CC number that modulates drive (0 = disabled)"
], [
    trn:symbol "cc_channel" ;
    trn:label "CC Channel" ;
    trn:minimum 1 ; trn:maximum 16 ; trn:default 1 ;
    rdfs:comment "MIDI channel to listen on for all drive and shape CCs"
], [
    trn:symbol "stereo" ;
    trn:label "Stereo Split" ;
    trn:minimum 0 ; trn:maximum 1 ; trn:default 0 ;
    rdfs:comment "0=Linked (right mirrors left), 1=Split (right uses the R settings)"
], [
    trn:symbol "drive_r" ;
    trn:label "Drive R" ;
    trn:minimum 1.0 ; trn:maximum 10.0 ; trn:default 2.0 ;
    rdfs:comment "Right-channel drive (Split only)"
], [
    trn:symbol "mode_r" ;
    trn:label "Mode R" ;
    trn:minimum 0 ; trn:maximum 5 ; trn:default 1 ;
    rdfs:comment "Right-channel mode, same values as mode (Split only)"
], [
    trn:symbol "tone_r" ;
    trn:label "Tone R" ;
    trn:minimum 0.0 ; trn:maximum 100.0 ; trn:default 50.0 ;
    rdfs:comment "Right-channel tone (Split only)"
], [
    trn:symbol "fold_count_r" ;
    trn:label "Fold Count R" ;
    trn:minimum 1 ; trn:maximum 8 ; trn:default 2 ;
    rdfs:comment "Right-channel fold count, Wavefold only (Split only)"
], [
    trn:symbol "cc_drive_r" ;
    trn:label "CC Drive R" ;
    trn:minimum 0 ; trn:maximum 127 ; trn:default 0 ;
    rdfs:comment "MIDI CC number that modulates right-channel drive (0 = disabled; Split only)"
], [
    trn:symbol "cc_shape" ;
    trn:label "CC Shape" ;
    trn:minimum 0 ; trn:maximum 127 ; trn:default 0 ;
    rdfs:comment "MIDI CC number that selects the mode in six steps (0 = disabled); left, or both channels when Linked"
], [
    trn:symbol "cc_shape_r" ;
    trn:label "CC Shape R" ;
    trn:minimum 0 ; trn:maximum 127 ; trn:default 0 ;
    rdfs:comment "MIDI CC number that selects the right-channel mode (0 = disabled; Split only)"
] ;
    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
