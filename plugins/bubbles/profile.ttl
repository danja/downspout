@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dsp:bubbles a trn:PluginProfile ;
    rdfs:label "Bubbles" ;
    rdfs:comment "Hybrid subtractive/physical-modelling water sound generator: streams, rivers, ocean waves, bubbles, drips, and rain." ;
    trn:bundleName "bubbles.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/bubbles/> ;
    trn:role trn:InstrumentPlugin ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio .
