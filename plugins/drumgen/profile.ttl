@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:drumgen a trn:PluginProfile ;
    rdfs:label "DrumGen" ;
    rdfs:comment """Transport- and meter-aware MIDI drum generator with fills, style modes,
Breakbeat/Jazz/Fugue genres, sparse pulse options, Conductor CC control, and an optional
cellular-automaton layer that evolves chosen lanes (hats, percussion, toms) each loop.
The Pattern Mix sliders set hit placement/probability (Kick Hits, Snare/Clap Hits, Hat Hits,
Percussion Hits for bell/clave/bash, Fill Tom Hits, Crash/Bash Hits) — none are audio levels.
Its stereo audio output is a silent compatibility stub; route MIDI output to DrumKit
or another drum instrument.""" ;
    trn:bundleName "drumgen.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/drumgen/> ;
    trn:role trn:MidiGenerator ;
    trn:produces trn:Midi, trn:DrumMidi ;
    trn:accepts trn:ControlMidi ;
    trn:requires trn:HostTransport ;
    trn:genre "Breakbeat", "Amen", "Jungle", "Hip Hop", "Jazz", "Rock", "Dub", "Fugue", "Rumba", "Samba", "Township Jive" ;
    trn:conductorChannelParam "conductor_ch" ;
    trn:recommendedBefore dsp:drumkit ;
    trn:caution "The stereo audio output is intentionally silent; connect MIDI output to an instrument. Pattern Mix sliders change generated hits, not levels." ;

    ## Conductor CC input — enable by setting conductor_ch (1–16) to match Conductor's output channel
    trn:conductorSceneParam "conductor_scene" ;
    trn:ccMapping [
        trn:ccNumber 20 ;
        trn:ccRole "Scene" ;
        trn:targetParameter "fill" ;
        rdfs:comment """CC 20 is ignored unless conductor_scene=1 (default 0). When enabled, the shared Conductor seven-block table maps scenes to Fill:
  Null=1 leaves Fill unchanged, Intro=0 → 0.10, Theme=16 → 0.30, Develop=32 → 0.65,
  Break=64 → 1.0, Reprise=96 → 0.50, Coda=127 → 0.20. Other values snap to the nearest block."""
    ] ;
    trn:ccMapping [
        trn:ccNumber 21 ;
        trn:ccRole "Density" ;
        trn:targetParameter "density" ;
        rdfs:comment "0–127 → 0.0–1.0 overall hit density."
    ] ;
    trn:ccMapping [
        trn:ccNumber 22 ;
        trn:ccRole "Energy" ;
        trn:targetParameter "variation" ;
        rdfs:comment "0–127 → 0.0–1.0 pattern busyness/variation."
    ] ;
    trn:ccMapping [
        trn:ccNumber 23 ;
        trn:ccRole "Mutation" ;
        trn:targetParameter "vary" ;
        rdfs:comment "0–127 → 0.0–1.0 auto-mutation rate."
    ] ;
    trn:ccMapping [
        trn:ccNumber 24 ;
        trn:ccRole "Reset" ;
        trn:targetParameter "actionNew" ;
        trn:ccTriggerValue 127 ;
        rdfs:comment "Value 127 generates a fresh drum pattern."
    ] ;
    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
