@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:treatment a trn:PluginProfile ;
    rdfs:label "Treatment" ;
    rdfs:comment "Physically modelled residual acoustic treatment panel: a mass-air-mass absorber with a porous fill, derived from real panel geometry (cavity, air gap, facing mass, flow resistivity). Up to four panels in series, a Ring mode and a tempo-syncable geometry sweep make it a special effect. Randomise builds a new bank; five CCs drive panel 1." ;
    trn:bundleName "treatment.vst3" ;
    trn:vendor "danja" ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio, trn:ControlMidi ;
    trn:produces trn:Audio ;
    trn:caution "Flow Resist has a sweet spot near 4.1 kRayl/m at the default 100 mm cavity: too open or too dense a fill absorbs much less. This is physical, not a bug. In Absorb mode (the default) the plugin only ever attenuates; Ring mode boosts resonances by up to 9 dB per section, so keep Amount moderate on a four-panel bank. New in this version: 18 appended parameters (panels, panels 2-4 geometry, mode, sweep rate/depth/stereo/sync/division). Sweep Sync uses host BBT time; hosts that supply none fall back to Sweep Rate." ;
    trn:recommendedAfter dsp:drift ;
    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
