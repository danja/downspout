@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dsp:orchid a trn:PluginProfile ;
    rdfs:label "Orchid" ;
    rdfs:comment "Transport-aware voiced freeze effect using autocorrelation capture and grid-synchronised loop holds. Captured pitch is optionally quantised to one of 20 built-in scales. A retrigger threshold re-arms capture when input energy recovers." ;
    trn:bundleName "orchid.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/orchid/> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:requires trn:HostTransport .
