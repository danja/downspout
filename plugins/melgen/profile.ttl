@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dsp:melgen a trn:PluginProfile ;
    rdfs:label "MelGen" ;
    rdfs:comment "Phrase-aware melody generator with contour, question/answer structure, and reactions to incoming context." ;
    trn:bundleName "melgen.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/melgen/> ;
    trn:role trn:MidiGenerator ;
    trn:accepts trn:Midi, trn:ControlMidi ;
    trn:produces trn:Midi, trn:MelodyMidi ;
    trn:requires trn:HostTransport ;
    trn:busRole trn:BusReceiver ;
    trn:ccMapping [
        trn:ccNumber 20 ;
        trn:ccRole "Scene" ;
        trn:targetParameter "contour" ;
        rdfs:comment "Maps scene (0-127) to melodic contour shape (0-5: Wander/Flat/Rise/Fall/Arch/InvArch)."
    ] ;
    trn:ccMapping [
        trn:ccNumber 21 ;
        trn:ccRole "Instrument" ;
        trn:targetParameter "scale" ;
        rdfs:comment "Maps value (0-127) to scale selection (0-22)."
    ] ;
    trn:ccMapping [
        trn:ccNumber 22 ;
        trn:ccRole "Energy" ;
        trn:targetParameter "density" ;
        rdfs:comment "Overrides note density (0-1)."
    ] ;
    trn:ccMapping [
        trn:ccNumber 23 ;
        trn:ccRole "Mutation" ;
        trn:targetParameter "vary" ;
        rdfs:comment "Overrides variation amount (0-1 internally, 0-100 in UI)."
    ] ;
    trn:ccMapping [
        trn:ccNumber 24 ;
        trn:ccRole "Reset" ;
        rdfs:comment "Value 127 triggers a new pattern generation."
    ] .
