@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:sinevox a trn:PluginProfile ;
    rdfs:label "Sinevox" ;
    rdfs:comment "Formant tracker with two voices. Speech on inputs 1/2 is analysed for up to eight formants (centre frequency, Q, amplitude). Vocoder mode drives a parallel band-pass bank on inputs 3/4; sine wave speech mode drives a bank of sine oscillators. MIDI CC 1-5 control Shift, Q Scale, Formants, Tilt and Mode; held notes can transpose the formants; the speech fundamental is tracked and a sine at that pitch can be mixed in (Fundamental slider); the tracked formants can be sent out as CC 20-27 / 102-109 or as notes." ;
    trn:bundleName "sinevox.vst3" ;
    trn:vendor "danja" ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio, trn:ControlMidi ;
    trn:produces trn:Audio, trn:ControlMidi ;
    trn:caution "The port roles are load-bearing: inputs 1/2 are the speech that is analysed, inputs 3/4 the carrier the vocoder filters. Sine wave speech mode ignores 3/4. MIDI Out is off by default; when on it adds CC 20-27 and 102-109, or notes, on the Out Channel." ;
    trn:recommendedAfter dsp:drift ;
    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
