@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:prism a trn:PluginProfile ;
    rdfs:label "Prism" ;
    rdfs:comment "Stereo banded spectral delay. The spectrum is split into 1-8 log-spaced bands (31.25 Hz to 16 kHz); each band has its own left and right delay (0-2000 ms) and feedback, with delay and feedback interpolated in log frequency between band centres. Per-band solo, low and high cut, link L/R, four FFT resolutions." ;
    trn:bundleName "prism.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/prism/> ;
    trn:role trn:AudioEffect ;
    trn:requires trn:HostTransport ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:caution "Latency equals the FFT size (512-4096 samples, 11-85 ms at 48 kHz) and is reported to the host; changing Resolution clears the delay memory. Delays between band centres are approximate, and feedback repeats lose some level at certain delays (worst case about 2 dB by the fourth repeat). Tempo sync uses the host BBT tempo and is 120 BPM when the host gives none. A division longer than 2 s at the current tempo is limited to 2 s. No MIDI." ;
    trn:parameter [ rdfs:label "Bands" ; trn:symbol "bands" ; trn:range "1-8" ;
                    rdfs:comment "Number of active bands. Parameters of the bands beyond it are kept but unused." ] ;
    trn:parameter [ rdfs:label "Resolution" ; trn:symbol "size" ; trn:range "512, 1024, 2048, 4096" ;
                    rdfs:comment "FFT size. Sets latency and the time/frequency trade-off." ] ;
    trn:parameter [ rdfs:label "Low Cut" ; trn:symbol "low_cut" ; trn:range "20 Hz-2 kHz" ;
                    rdfs:comment "Below it nothing is delayed (a third-of-an-octave ramp). Off at 20 Hz." ] ;
    trn:parameter [ rdfs:label "High Cut" ; trn:symbol "high_cut" ; trn:range "200 Hz-20 kHz" ;
                    rdfs:comment "Above it nothing is delayed. Off at 20 kHz." ] ;
    trn:parameter [ rdfs:label "Mix" ; trn:symbol "mix" ; trn:range "0-100" ;
                    rdfs:comment "Dry/delayed balance. The dry path is delayed by the latency. Overridden to 100 while a band is soloed." ] ;
    trn:parameter [ rdfs:label "Link L/R" ; trn:symbol "link" ; trn:range "Off, On" ;
                    rdfs:comment "On: the right side of every band follows the left (delay, sync mode and division)." ] ;
    trn:parameter [ rdfs:label "Sync L" ; trn:symbol "sync_l" ; trn:range "ms, RATE" ;
                    rdfs:comment "RATE: left delays are note divisions of the host tempo (band division parameters) instead of milliseconds." ] ;
    trn:parameter [ rdfs:label "Sync R" ; trn:symbol "sync_r" ; trn:range "ms, RATE" ;
                    rdfs:comment "As Sync L, for the right side. Ignored while Link L/R is on." ] ;
    trn:parameter [ rdfs:label "Band 1 L Delay" ; trn:symbol "b1_delay_l" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Left-channel delay of band 1." ] ;
    trn:parameter [ rdfs:label "Band 1 R Delay" ; trn:symbol "b1_delay_r" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Right-channel delay of band 1." ] ;
    trn:parameter [ rdfs:label "Band 1 Feedback" ; trn:symbol "b1_feedback" ; trn:range "0-95" ;
                    rdfs:comment "Feedback of band 1, per cent." ] ;
    trn:parameter [ rdfs:label "Band 1 Solo" ; trn:symbol "b1_solo" ; trn:range "Off, On" ;
                    rdfs:comment "Hear only the delayed sound of this band (soloed bands together)." ] ;
    trn:parameter [ rdfs:label "Band 1 L Division" ; trn:symbol "b1_div_l" ; trn:range "1/64, 1/32, 1/16T, 1/16, 1/16D, 1/8T, 1/8, 1/8D, 1/4T, 1/4, 1/4D, 1/2, 1/1" ;
                    rdfs:comment "Left delay of band 1 while Sync L is RATE." ] ;
    trn:parameter [ rdfs:label "Band 1 R Division" ; trn:symbol "b1_div_r" ; trn:range "1/64 ... 1/1" ;
                    rdfs:comment "Right delay of band 1 while Sync R is RATE and Link L/R is off." ] ;
    trn:parameter [ rdfs:label "Band 2 L Delay" ; trn:symbol "b2_delay_l" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Left-channel delay of band 2." ] ;
    trn:parameter [ rdfs:label "Band 2 R Delay" ; trn:symbol "b2_delay_r" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Right-channel delay of band 2." ] ;
    trn:parameter [ rdfs:label "Band 2 Feedback" ; trn:symbol "b2_feedback" ; trn:range "0-95" ;
                    rdfs:comment "Feedback of band 2, per cent." ] ;
    trn:parameter [ rdfs:label "Band 2 Solo" ; trn:symbol "b2_solo" ; trn:range "Off, On" ;
                    rdfs:comment "Hear only the delayed sound of this band (soloed bands together)." ] ;
    trn:parameter [ rdfs:label "Band 2 L Division" ; trn:symbol "b2_div_l" ; trn:range "1/64, 1/32, 1/16T, 1/16, 1/16D, 1/8T, 1/8, 1/8D, 1/4T, 1/4, 1/4D, 1/2, 1/1" ;
                    rdfs:comment "Left delay of band 2 while Sync L is RATE." ] ;
    trn:parameter [ rdfs:label "Band 2 R Division" ; trn:symbol "b2_div_r" ; trn:range "1/64 ... 1/1" ;
                    rdfs:comment "Right delay of band 2 while Sync R is RATE and Link L/R is off." ] ;
    trn:parameter [ rdfs:label "Band 3 L Delay" ; trn:symbol "b3_delay_l" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Left-channel delay of band 3." ] ;
    trn:parameter [ rdfs:label "Band 3 R Delay" ; trn:symbol "b3_delay_r" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Right-channel delay of band 3." ] ;
    trn:parameter [ rdfs:label "Band 3 Feedback" ; trn:symbol "b3_feedback" ; trn:range "0-95" ;
                    rdfs:comment "Feedback of band 3, per cent." ] ;
    trn:parameter [ rdfs:label "Band 3 Solo" ; trn:symbol "b3_solo" ; trn:range "Off, On" ;
                    rdfs:comment "Hear only the delayed sound of this band (soloed bands together)." ] ;
    trn:parameter [ rdfs:label "Band 3 L Division" ; trn:symbol "b3_div_l" ; trn:range "1/64, 1/32, 1/16T, 1/16, 1/16D, 1/8T, 1/8, 1/8D, 1/4T, 1/4, 1/4D, 1/2, 1/1" ;
                    rdfs:comment "Left delay of band 3 while Sync L is RATE." ] ;
    trn:parameter [ rdfs:label "Band 3 R Division" ; trn:symbol "b3_div_r" ; trn:range "1/64 ... 1/1" ;
                    rdfs:comment "Right delay of band 3 while Sync R is RATE and Link L/R is off." ] ;
    trn:parameter [ rdfs:label "Band 4 L Delay" ; trn:symbol "b4_delay_l" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Left-channel delay of band 4." ] ;
    trn:parameter [ rdfs:label "Band 4 R Delay" ; trn:symbol "b4_delay_r" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Right-channel delay of band 4." ] ;
    trn:parameter [ rdfs:label "Band 4 Feedback" ; trn:symbol "b4_feedback" ; trn:range "0-95" ;
                    rdfs:comment "Feedback of band 4, per cent." ] ;
    trn:parameter [ rdfs:label "Band 4 Solo" ; trn:symbol "b4_solo" ; trn:range "Off, On" ;
                    rdfs:comment "Hear only the delayed sound of this band (soloed bands together)." ] ;
    trn:parameter [ rdfs:label "Band 4 L Division" ; trn:symbol "b4_div_l" ; trn:range "1/64, 1/32, 1/16T, 1/16, 1/16D, 1/8T, 1/8, 1/8D, 1/4T, 1/4, 1/4D, 1/2, 1/1" ;
                    rdfs:comment "Left delay of band 4 while Sync L is RATE." ] ;
    trn:parameter [ rdfs:label "Band 4 R Division" ; trn:symbol "b4_div_r" ; trn:range "1/64 ... 1/1" ;
                    rdfs:comment "Right delay of band 4 while Sync R is RATE and Link L/R is off." ] ;
    trn:parameter [ rdfs:label "Band 5 L Delay" ; trn:symbol "b5_delay_l" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Left-channel delay of band 5." ] ;
    trn:parameter [ rdfs:label "Band 5 R Delay" ; trn:symbol "b5_delay_r" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Right-channel delay of band 5." ] ;
    trn:parameter [ rdfs:label "Band 5 Feedback" ; trn:symbol "b5_feedback" ; trn:range "0-95" ;
                    rdfs:comment "Feedback of band 5, per cent." ] ;
    trn:parameter [ rdfs:label "Band 5 Solo" ; trn:symbol "b5_solo" ; trn:range "Off, On" ;
                    rdfs:comment "Hear only the delayed sound of this band (soloed bands together)." ] ;
    trn:parameter [ rdfs:label "Band 5 L Division" ; trn:symbol "b5_div_l" ; trn:range "1/64, 1/32, 1/16T, 1/16, 1/16D, 1/8T, 1/8, 1/8D, 1/4T, 1/4, 1/4D, 1/2, 1/1" ;
                    rdfs:comment "Left delay of band 5 while Sync L is RATE." ] ;
    trn:parameter [ rdfs:label "Band 5 R Division" ; trn:symbol "b5_div_r" ; trn:range "1/64 ... 1/1" ;
                    rdfs:comment "Right delay of band 5 while Sync R is RATE and Link L/R is off." ] ;
    trn:parameter [ rdfs:label "Band 6 L Delay" ; trn:symbol "b6_delay_l" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Left-channel delay of band 6." ] ;
    trn:parameter [ rdfs:label "Band 6 R Delay" ; trn:symbol "b6_delay_r" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Right-channel delay of band 6." ] ;
    trn:parameter [ rdfs:label "Band 6 Feedback" ; trn:symbol "b6_feedback" ; trn:range "0-95" ;
                    rdfs:comment "Feedback of band 6, per cent." ] ;
    trn:parameter [ rdfs:label "Band 6 Solo" ; trn:symbol "b6_solo" ; trn:range "Off, On" ;
                    rdfs:comment "Hear only the delayed sound of this band (soloed bands together)." ] ;
    trn:parameter [ rdfs:label "Band 6 L Division" ; trn:symbol "b6_div_l" ; trn:range "1/64, 1/32, 1/16T, 1/16, 1/16D, 1/8T, 1/8, 1/8D, 1/4T, 1/4, 1/4D, 1/2, 1/1" ;
                    rdfs:comment "Left delay of band 6 while Sync L is RATE." ] ;
    trn:parameter [ rdfs:label "Band 6 R Division" ; trn:symbol "b6_div_r" ; trn:range "1/64 ... 1/1" ;
                    rdfs:comment "Right delay of band 6 while Sync R is RATE and Link L/R is off." ] ;
    trn:parameter [ rdfs:label "Band 7 L Delay" ; trn:symbol "b7_delay_l" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Left-channel delay of band 7." ] ;
    trn:parameter [ rdfs:label "Band 7 R Delay" ; trn:symbol "b7_delay_r" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Right-channel delay of band 7." ] ;
    trn:parameter [ rdfs:label "Band 7 Feedback" ; trn:symbol "b7_feedback" ; trn:range "0-95" ;
                    rdfs:comment "Feedback of band 7, per cent." ] ;
    trn:parameter [ rdfs:label "Band 7 Solo" ; trn:symbol "b7_solo" ; trn:range "Off, On" ;
                    rdfs:comment "Hear only the delayed sound of this band (soloed bands together)." ] ;
    trn:parameter [ rdfs:label "Band 7 L Division" ; trn:symbol "b7_div_l" ; trn:range "1/64, 1/32, 1/16T, 1/16, 1/16D, 1/8T, 1/8, 1/8D, 1/4T, 1/4, 1/4D, 1/2, 1/1" ;
                    rdfs:comment "Left delay of band 7 while Sync L is RATE." ] ;
    trn:parameter [ rdfs:label "Band 7 R Division" ; trn:symbol "b7_div_r" ; trn:range "1/64 ... 1/1" ;
                    rdfs:comment "Right delay of band 7 while Sync R is RATE and Link L/R is off." ] ;
    trn:parameter [ rdfs:label "Band 8 L Delay" ; trn:symbol "b8_delay_l" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Left-channel delay of band 8." ] ;
    trn:parameter [ rdfs:label "Band 8 R Delay" ; trn:symbol "b8_delay_r" ; trn:range "0-2000 ms" ;
                    rdfs:comment "Right-channel delay of band 8." ] ;
    trn:parameter [ rdfs:label "Band 8 Feedback" ; trn:symbol "b8_feedback" ; trn:range "0-95" ;
                    rdfs:comment "Feedback of band 8, per cent." ] ;
    trn:parameter [ rdfs:label "Band 8 Solo" ; trn:symbol "b8_solo" ; trn:range "Off, On" ;
                    rdfs:comment "Hear only the delayed sound of this band (soloed bands together)." ] ;
    trn:parameter [ rdfs:label "Band 8 L Division" ; trn:symbol "b8_div_l" ; trn:range "1/64, 1/32, 1/16T, 1/16, 1/16D, 1/8T, 1/8, 1/8D, 1/4T, 1/4, 1/4D, 1/2, 1/1" ;
                    rdfs:comment "Left delay of band 8 while Sync L is RATE." ] ;
    trn:parameter [ rdfs:label "Band 8 R Division" ; trn:symbol "b8_div_r" ; trn:range "1/64 ... 1/1" ;
                    rdfs:comment "Right delay of band 8 while Sync R is RATE and Link L/R is off." ] ;
    trn:parameter [ rdfs:label "Latency" ; trn:symbol "out_latency" ; trn:range "0-400 ms" ;
                    rdfs:comment "Read-only: processing delay in use." ] ;
    trn:parameter [ rdfs:label "Tempo" ; trn:symbol "out_tempo" ; trn:range "20-300 BPM" ;
                    rdfs:comment "Read-only: the host tempo in use (120 when none)." ] ;
    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
