@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dsp:rift a trn:PluginProfile ;
    rdfs:label "Rift" ;
    rdfs:comment "Transport-locked live/sample buffer disruptor for chop, stutter, reverse, skip, smear, and pitch-slip actions." ;
    trn:bundleName "rift.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/rift/> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:requires trn:HostTransport ;
    trn:caution "Use repeats and pitch-slip conservatively in dense arrangements." .
