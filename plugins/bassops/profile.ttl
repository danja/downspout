@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dsp:bassops a trn:PluginProfile ;
    rdfs:label "Bassops" ;
    rdfs:comment """Sidechain ducker with harmonic stereo synthesis. A kick-drum or other
control signal on inputs 3-4 (audio sidechain) drives an envelope follower whose inverted
output attenuates the main stereo signal on inputs 1-2. After ducking, the stereo signal
is summed to mono and split by a complementary Hann-windowed sinc LP/HP FIR pair (order
128, latency 64 samples). The LP path produces the clean bass centre component; optionally
distorted mono fed to the HP path becomes the stereo-difference component after M/S
decoding, generating stereo width above the crossover from the added harmonics. At Side
Shape 0 the wet output is phase-coherent mono. A Wet control blends the processed signal
against the latency-compensated dry stereo input. Introduces 64-sample FIR latency
reported to the host.""" ;
    trn:bundleName "bassops.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/bassops/> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio, trn:AudioSidechain, trn:ControlMidi ;
    trn:produces trn:Audio ;
    trn:busRole trn:BusReceiver ;

    trn:ccMapping [
        trn:ccNumber 34 ;
        trn:ccRole "Duck Depth" ;
        trn:targetParameter "duck_depth" ;
        rdfs:comment "Temporarily overrides duck depth; Release MIDI restores the saved panel value. Requires MIDI input enabled."
    ] ;
    trn:ccMapping [
        trn:ccNumber 35 ;
        trn:ccRole "Wet" ;
        trn:targetParameter "wet" ;
        rdfs:comment "Temporarily overrides wet/dry blend; Release MIDI restores the saved panel value. Requires MIDI input enabled."
    ] ;
    trn:ccMapping [
        trn:ccNumber 19 ;
        trn:ccRole "Gate" ;
        trn:ccGate true ;
        rdfs:comment "Optional ownership gate: acquires/releases control of CC 34 and CC 35. Requires MIDI input enabled."
    ] ;

    ## Automatable parameters
    trn:parameter [
        rdfs:label "Duck Depth" ;
        trn:symbol "duck_depth" ;
        trn:unit "%" ;
        rdfs:comment "How much the main signal is attenuated when the sidechain envelope reaches full scale. 0 = no ducking; 100 = full silence on hit." ;
        trn:default "80.0"^^xsd:float ;
        trn:min "0.0"^^xsd:float ;
        trn:max "100.0"^^xsd:float
    ] ;
    trn:parameter [
        rdfs:label "Attack" ;
        trn:symbol "attack_ms" ;
        trn:unit "ms" ;
        rdfs:comment "Envelope follower rise time. Shorter values track transients tightly; longer values produce a slower pump." ;
        trn:default "10.0"^^xsd:float ;
        trn:min "1.0"^^xsd:float ;
        trn:max "500.0"^^xsd:float
    ] ;
    trn:parameter [
        rdfs:label "Release" ;
        trn:symbol "release_ms" ;
        trn:unit "ms" ;
        rdfs:comment "Envelope follower fall time. Controls how quickly the main signal returns to full level after the sidechain transient." ;
        trn:default "100.0"^^xsd:float ;
        trn:min "10.0"^^xsd:float ;
        trn:max "2000.0"^^xsd:float
    ] ;
    trn:parameter [
        rdfs:label "M/S Cutoff" ;
        trn:symbol "cutoff_hz" ;
        trn:unit "Hz" ;
        rdfs:comment "LP/HP crossover frequency. Below this, only the clean mono sum passes through (locked centre). Above it, the distorted HP path forms the stereo-difference component after M/S decoding." ;
        trn:default "200.0"^^xsd:float ;
        trn:min "50.0"^^xsd:float ;
        trn:max "5000.0"^^xsd:float
    ] ;
    trn:parameter [
        rdfs:label "Side Shape" ;
        trn:symbol "side_shape" ;
        trn:unit "%" ;
        rdfs:comment "Distortion amount on the HP path. 0 = no distortion, wet output is mono. 100 = drive x8 with hard clipping, maximum stereo width above cutoff. Gain-normalised to unity for small signals." ;
        trn:default "0.0"^^xsd:float ;
        trn:min "0.0"^^xsd:float ;
        trn:max "100.0"^^xsd:float
    ] ;
    trn:parameter [
        rdfs:label "Wet" ;
        trn:symbol "wet" ;
        trn:unit "%" ;
        rdfs:comment "Wet/dry blend. 0 = dry original stereo (latency-compensated); 100 = fully processed. Dry is the only path that preserves the input's original stereo difference." ;
        trn:default "100.0"^^xsd:float ;
        trn:min "0.0"^^xsd:float ;
        trn:max "100.0"^^xsd:float
    ] ;

    ## Read-only meter outputs (not automatable; driven by the DSP)
    trn:parameter [
        rdfs:label "Input Level" ;
        trn:symbol "input_level" ;
        rdfs:comment "Peak amplitude of the main stereo input, 0-1, with ballistic decay. Read-only." ;
        trn:default "0.0"^^xsd:float ;
        trn:min "0.0"^^xsd:float ;
        trn:max "1.0"^^xsd:float ;
        trn:readonly true
    ] ;
    trn:parameter [
        rdfs:label "Sidechain Level" ;
        trn:symbol "sc_level" ;
        rdfs:comment "Current sidechain envelope follower output, 0-1. Read-only." ;
        trn:default "0.0"^^xsd:float ;
        trn:min "0.0"^^xsd:float ;
        trn:max "1.0"^^xsd:float ;
        trn:readonly true
    ] ;
    trn:parameter [
        rdfs:label "Duck Gain" ;
        trn:symbol "duck_gain" ;
        rdfs:comment "Current VCA gain applied to the main signal, 0-1. 1 = no ducking; 0 = fully ducked. Read-only." ;
        trn:default "1.0"^^xsd:float ;
        trn:min "0.0"^^xsd:float ;
        trn:max "1.0"^^xsd:float ;
        trn:readonly true
    ] ;
    trn:parameter [
        rdfs:label "Output Level" ;
        trn:symbol "output_level" ;
        rdfs:comment "Mean-absolute amplitude of the stereo output after ducking and processing, 0-1, with fast-release ballistic. Read-only." ;
        trn:default "0.0"^^xsd:float ;
        trn:min "0.0"^^xsd:float ;
        trn:max "1.0"^^xsd:float ;
        trn:readonly true
    ] ;

    trn:caution "Introduces 64-sample linear-phase FIR latency; enable delay compensation in the host. Route a dry kick send to inputs 3-4 (AudioSidechain), not a processed bus, to avoid timing smear on the envelope follower. At Wet=100 and Side Shape=0 the output is mono; use the Wet control or raise Side Shape to restore stereo content." .
