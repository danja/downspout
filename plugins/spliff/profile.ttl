@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:spliff a trn:PluginProfile ;
    rdfs:label "Spliff" ;
    rdfs:comment "Adaptive transient processor in the Spiff manner: detects transients per frequency band and applies dynamic cuts or boosts only where transient energy exists, leaving the rest of the spectrum intact." ;
    trn:bundleName "spliff.vst3" ;
    trn:vendor "danja" ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio, trn:ControlMidi ;
    trn:produces trn:Audio ;
    trn:caution "Boost mode before compressors or limiters can produce hot peaks; Delta monitoring is loudness-neutral but the wet path is not." ;
    trn:recommendedAfter dsp:drift ;
    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
