@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:spliff a trn:PluginProfile ;
    rdfs:label "Spliff" ;
    rdfs:comment "Adaptive transient processor with 3-band Spiff-style Cut/Boost (up to -30 dB/+18 dB) plus a third level-independent Designer mode. Depth, Sensitivity and Sharpness default to 70% so steady material is processed audibly out of the box. Split Low/High steer the sensitivity curve, Drift CC routing lives on its own tab, and a 64-band analyser shows the input, output or wet-minus-dry delta signal. The appended automatable analyser_source parameter (mirrored as text state) selects that view so REAPER's VST3 controller cannot drop the switch." ;
    trn:bundleName "spliff.vst3" ;
    trn:vendor "danja" ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio, trn:ControlMidi ;
    trn:produces trn:Audio ;
    trn:caution "Boost mode before compressors or limiters can produce hot peaks; Designer Attack/Sustain are level-independent but their wet path can still peak; Delta monitoring is loudness-neutral but the wet path is not." ;
    trn:recommendedAfter dsp:drift ;
    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
