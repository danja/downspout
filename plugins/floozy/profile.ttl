@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dsp:floozy a trn:PluginProfile ;
    rdfs:label "Floozy" ;
    rdfs:comment "Eight-voice hybrid physical/modulation synthesizer for expressive leads, plucks, and synthetic textures." ;
    trn:bundleName "floozy.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/floozy/> ;
    trn:role trn:Instrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio .
