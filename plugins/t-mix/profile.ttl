@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dsp:t-mix a trn:PluginProfile ;
    rdfs:label "T-Mix" ;
    rdfs:comment "Eight-input mono-strip mixer with level, pan, mute, solo, metering, and stereo master output." ;
    trn:bundleName "t_mix.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/t_mix/> ;
    trn:role trn:AudioMixer ;
    trn:busRole trn:BusReceiver ;
    trn:accepts trn:Audio, trn:ControlMidi ;
    trn:produces trn:Audio ;

    ## Producer Control Bus CC input — strip gains (one CC per MIDI channel)
    trn:ccMapping [
        trn:ccNumber 20 ;
        trn:ccRole "Strip gain" ;
        trn:targetParameter "level" ;
        rdfs:comment "CC 20 on channels 1–8 overrides the gain for strips 1–8 respectively."
    ] ;
    trn:ccMapping [
        trn:ccNumber 19 ;
        trn:ccRole "Gate" ;
        rdfs:comment "Optional ownership gate: acquires/releases control of CC 20 on all channels."
    ] ;
    rdfs:comment "Strip gain overrides are temporary; releasing the producer restores panel values. See docs/producer-control-bus.md." .
