@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dsp:counterpointer a trn:PluginProfile ;
    rdfs:label "Counterpointer" ;
    rdfs:comment "Learns incoming MIDI and emits a related monophonic counter-melody." ;
    trn:bundleName "counterpointer.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/counterpointer/> ;
    trn:role trn:MidiProcessor ;
    trn:accepts trn:Midi ;
    trn:produces trn:Midi, trn:MelodyMidi ;
    trn:recommendedBefore dsp:canticle .
