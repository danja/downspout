@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:sprout a trn:PluginProfile ;
    rdfs:label "Sprout" ;
    rdfs:comment "L-system MIDI generator: seven grammars rewritten per generation, read as a turtle and played as a scale-quantised (or held-note) monophonic line locked to the transport. Optional MIDI input: held notes as the pitch source, and the Drift and Conductor CC sets." ;
    trn:bundleName "sprout.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/sprout/> ;
    trn:role trn:MidiGenerator ;
    trn:accepts trn:Midi, trn:ControlMidi ;
    trn:produces trn:Midi ;
    trn:requires trn:HostTransport ;
    trn:caution "Silent while the transport is stopped. Expansions beyond 131072 symbols are not used; the deepest generation that fits plays instead." ;
    trn:parameter [ rdfs:label "Grammar" ; trn:symbol "preset" ; trn:range "Plant, Koch, Dragon, Sierpinski, Cantor, Levy, Tree" ;
                    rdfs:comment "Rewriting rules. F/G note, f rest, +/- pitch, [ ] branch." ] ;
    trn:parameter [ rdfs:label "Generations" ; trn:symbol "generations" ; trn:range "1-16" ;
                    rdfs:comment "Number of rewrites." ] ;
    trn:parameter [ rdfs:label "Grow every" ; trn:symbol "grow_bars" ; trn:range "0-16 bars" ;
                    rdfs:comment "0 plays the final generation; otherwise start at generation 1 and add one every N bars." ] ;
    trn:parameter [ rdfs:label "Scale" ; trn:symbol "scale" ; trn:range "0-23" ;
                    rdfs:comment "Canonical scale order from docs/scales.md (0 chromatic, 1 major, 3 minor, 23 bebop minor)." ] ;
    trn:parameter [ rdfs:label "Root note" ; trn:symbol "root" ; trn:range "0-127" ;
                    rdfs:comment "Pitch at the turtle's starting position." ] ;
    trn:parameter [ rdfs:label "Step size" ; trn:symbol "step_size" ; trn:range "1-3 degrees" ;
                    rdfs:comment "Scale degrees moved by each + or -." ] ;
    trn:parameter [ rdfs:label "Range" ; trn:symbol "range" ; trn:range "3-28 degrees" ;
                    rdfs:comment "Pitch folds back at this distance from the root." ] ;
    trn:parameter [ rdfs:label "Step grid" ; trn:symbol "grid" ; trn:range "1/32, 1/16T, 1/16, 1/16., 1/8T, 1/8, 1/8., 1/4T, 1/4, 1/4., 1/2, 1 bar" ;
                    rdfs:comment "Length of one step as a note value (T triplet, . dotted); 1 bar follows the host time signature. Default 1/16." ] ;
    trn:parameter [ rdfs:label "Gate" ; trn:symbol "gate" ; trn:range "10-100 %" ;
                    rdfs:comment "Fraction of the step the note is held." ] ;
    trn:parameter [ rdfs:label "Probability" ; trn:symbol "probability" ; trn:range "0-100 %" ;
                    rdfs:comment "Chance that a note step sounds; seeded and repeatable." ] ;
    trn:parameter [ rdfs:label "Velocity" ; trn:symbol "velocity" ; trn:range "1-127" ;
                    rdfs:comment "Base velocity; branches are 10 per level softer, the first step 10 louder." ] ;
    trn:parameter [ rdfs:label "Channel" ; trn:symbol "channel" ; trn:range "1-16" ;
                    rdfs:comment "MIDI output channel." ] ;
    trn:parameter [ rdfs:label "Seed" ; trn:symbol "seed" ; trn:range "1-65535" ;
                    rdfs:comment "Identity for the probability choices." ] ;
    trn:parameter [ rdfs:label "Pattern steps" ; trn:symbol "status_length" ; trn:range "0-131072" ;
                    rdfs:comment "Read-only: length of the pattern in steps." ] ;
    trn:parameter [ rdfs:label "Generation" ; trn:symbol "status_generation" ; trn:range "0-16" ;
                    rdfs:comment "Read-only: generation currently playing." ] ;
    trn:parameter [ rdfs:label "Current step" ; trn:symbol "status_step" ; trn:range "0-131072" ;
                    rdfs:comment "Read-only: playhead position in the pattern." ] ;
    trn:parameter [ rdfs:label "Pitch source" ; trn:symbol "pitch_source" ; trn:range "Scale, Held, Latched" ;
                    rdfs:comment "Scale (default) is the original behaviour. Held and Latched map the turtle's degrees onto the notes currently held on the MIDI input: degree 0 is the lowest held note and degrees are spread across the held tones (about seven per octave). Nothing held is a rest. Held plays the keys down now; Latched keeps the chord after the keys are released and replaces it with the first note pressed once every key is up." ] ;
    trn:parameter [ rdfs:label "Input channel" ; trn:symbol "input_channel" ; trn:range "0-16" ;
                    rdfs:comment "Channel whose notes count as held; 0 = all channels." ] ;
    trn:parameter [ rdfs:label "CC channel" ; trn:symbol "cc_channel" ; trn:range "0-16" ;
                    rdfs:comment "Off at 0. Otherwise on that channel (Drift convention): CC 1 Probability, CC 2 Gate, CC 3 Range, CC 4 Generations, each scaled 0-127 across the parameter's range and written through to the parameter." ] ;
    trn:parameter [ rdfs:label "Conductor ch" ; trn:symbol "conductor_ch" ; trn:range "0-16" ;
                    rdfs:comment "Off at 0. Otherwise on that channel (Conductor protocol): CC 21 Density to Probability, CC 22 Energy to Velocity, CC 23 Mutation to Seed, CC 24 = 127 restarts the pattern at the next bar line. CC 20 is not used." ] ;
    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
