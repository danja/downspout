@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:padseq a trn:PluginProfile ;
    rdfs:label "PadSeq" ;
    rdfs:comment "Paged 8x8 MIDI step sequencer for a Launchpad, with note columns, time rows, 1-32 steps, canonical scales and GM drum mapping." ;
    trn:bundleName "padseq.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/padseq/> ;
    trn:role trn:MidiGenerator, trn:Controller ;
    trn:accepts trn:Midi ;
    trn:produces trn:Midi, trn:MelodyMidi ;
    trn:caution "Free clock needs no transport; host clock reads BBT. LED feedback needs a Launchpad in programmer mode. The UI edits the same grid and triggers the same notes without hardware." ;
    trn:parameter [ rdfs:label "Steps" ; trn:symbol "steps" ; trn:range "1-32 (default 16)" ;
                    rdfs:comment "Sixteenth-note steps; four steps per beat, four pages of eight." ] ;
    trn:parameter [ rdfs:label "Scale" ; trn:symbol "scale" ; trn:range "0-32 (default 1, Major)" ;
                    rdfs:comment "Append-only ordinals from docs/scales.md." ] ;
    trn:parameter [ rdfs:label "Root" ; trn:symbol "root_note" ; trn:range "0-127 (default 60)" ] ;
    trn:parameter [ rdfs:label "Note View" ; trn:symbol "note_view" ; trn:range "-32 to +32 (default 0)" ;
                    rdfs:comment "Slides the eight note columns up or down in scale steps." ] ;
    trn:parameter [ rdfs:label "Page" ; trn:symbol "page" ; trn:range "0-3 (default 0)" ] ;
    trn:parameter [ rdfs:label "MIDI Channel" ; trn:symbol "midi_channel" ; trn:range "1-16 (default 4)" ;
                    rdfs:comment "Channel 4 avoids the Launchpad LED channels 1-3." ] ;
    trn:parameter [ rdfs:label "Note Map" ; trn:symbol "note_map" ; trn:range "Scale, GM Drums" ] ;
    trn:parameter [ rdfs:label "Clock" ; trn:symbol "clock" ; trn:range "Auto, Host, Free" ] ;
    trn:parameter [ rdfs:label "Free Tempo" ; trn:symbol "free_tempo" ; trn:range "40-240 BPM (default 120)" ] ;
    trn:parameter [ rdfs:label "Velocity" ; trn:symbol "velocity" ; trn:range "1-127 (default 100)" ] ;
    trn:parameter [ rdfs:label "Random Seed" ; trn:symbol "random_seed" ; trn:range "1-65535 (default 12345)" ] ;
    trn:parameter [ rdfs:label "Randomise" ; trn:symbol "randomise" ; trn:range "trigger" ] ;
    trn:parameter [ rdfs:label "Clear / Panic" ; trn:symbol "clear_panic" ; trn:range "trigger" ] ;
    trn:parameter [ rdfs:label "Trigger Column 1" ; trn:symbol "trigger_column_1" ; trn:range "trigger" ;
                    rdfs:comment "UI equivalent of side CC 19; note-off is queued for the next sixteenth step." ] ;
    trn:parameter [ rdfs:label "Trigger Column 2" ; trn:symbol "trigger_column_2" ; trn:range "trigger" ] ;
    trn:parameter [ rdfs:label "Trigger Column 3" ; trn:symbol "trigger_column_3" ; trn:range "trigger" ] ;
    trn:parameter [ rdfs:label "Trigger Column 4" ; trn:symbol "trigger_column_4" ; trn:range "trigger" ] ;
    trn:parameter [ rdfs:label "Trigger Column 5" ; trn:symbol "trigger_column_5" ; trn:range "trigger" ] ;
    trn:parameter [ rdfs:label "Trigger Column 6" ; trn:symbol "trigger_column_6" ; trn:range "trigger" ] ;
    trn:parameter [ rdfs:label "Trigger Column 7" ; trn:symbol "trigger_column_7" ; trn:range "trigger" ] ;
    trn:parameter [ rdfs:label "Trigger Column 8" ; trn:symbol "trigger_column_8" ; trn:range "trigger" ] ;
    trn:parameter [ rdfs:label "LED Feedback" ; trn:symbol "led_feedback" ; trn:range "Off, On (default On)" ] ;
    trn:parameter [ rdfs:label "Pass Input" ; trn:symbol "pass_input" ; trn:range "Off, On (default Off)" ] ;

    ## Top row: note view, page, scale, randomise and clear.
    trn:ccMapping [ trn:ccNumber 91 ; trn:ccRole "View down" ; trn:targetParameter "note_view" ;
                    rdfs:comment "Moves the visible note columns down one scale step." ] ;
    trn:ccMapping [ trn:ccNumber 92 ; trn:ccRole "View up" ; trn:targetParameter "note_view" ] ;
    trn:ccMapping [ trn:ccNumber 93 ; trn:ccRole "Previous page" ; trn:targetParameter "page" ] ;
    trn:ccMapping [ trn:ccNumber 94 ; trn:ccRole "Next page" ; trn:targetParameter "page" ] ;
    trn:ccMapping [ trn:ccNumber 95 ; trn:ccRole "Previous scale" ; trn:targetParameter "scale" ] ;
    trn:ccMapping [ trn:ccNumber 96 ; trn:ccRole "Next scale" ; trn:targetParameter "scale" ] ;
    trn:ccMapping [ trn:ccNumber 97 ; trn:ccRole "Randomise" ; trn:targetParameter "randomise" ;
                    rdfs:comment "Modifies an existing pattern or seeds a new one." ] ;
    trn:ccMapping [ trn:ccNumber 98 ; trn:ccRole "Clear and panic" ; trn:targetParameter "clear_panic" ;
                    rdfs:comment "Clears the pattern and emits all-notes-off plus LED reset." ] ;
    trn:ccMapping [ trn:ccNumber 99 ; trn:ccRole "Logo (unused)" ;
                    rdfs:comment "Reserved on Mini MK3 style mappings." ] ;

    ## Right side: one note trigger per grid column.
    trn:ccMapping [ trn:ccNumber 19 ; trn:ccRole "Trigger column 1" ;
                    rdfs:comment "Plays the column note; note-off is timed to the next grid step." ] ;
    trn:ccMapping [ trn:ccNumber 29 ; trn:ccRole "Trigger column 2" ] ;
    trn:ccMapping [ trn:ccNumber 39 ; trn:ccRole "Trigger column 3" ] ;
    trn:ccMapping [ trn:ccNumber 49 ; trn:ccRole "Trigger column 4" ] ;
    trn:ccMapping [ trn:ccNumber 59 ; trn:ccRole "Trigger column 5" ] ;
    trn:ccMapping [ trn:ccNumber 69 ; trn:ccRole "Trigger column 6" ] ;
    trn:ccMapping [ trn:ccNumber 79 ; trn:ccRole "Trigger column 7" ] ;
    trn:ccMapping [ trn:ccNumber 89 ; trn:ccRole "Trigger column 8" ] ;

    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
