@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:guardian a trn:PluginProfile ;
    rdfs:label "Guardian" ;
    rdfs:comment "Output-safety processor with default-on clip interpolation, input gain, look-ahead limiting (attack + program release), optional auto drive to a target reduction, variable-curve clipping, DC removal, 4x inter-sample peak guard, bypass, and a protection-density output." ;
    trn:bundleName "guardian.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/guardian/> ;
    trn:role trn:AudioEffect, trn:Utility ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:recommendedAfter dsp:orbit ;
    trn:caution "Guardian is intended for the end of autonomous audio chains and reports look-ahead plus the 5 ms interpolation window as latency when interpolation is enabled." ;
    pu:supportedPlatform pu:Windows, pu:MacOS, pu:Linux .
