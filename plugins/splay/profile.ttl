@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pu:   <http://purl.org/stuff/plugin-universe/> .

dsp:splay a trn:PluginProfile ;
    rdfs:label "Splay" ;
    rdfs:comment "Stereo matrix and image shaper: four input-to-output gains, stereo rotation, pan-law compensation, mid/side trims and solo, optional two-band width, fractional right-channel image delay, right-channel phase invert, output level, click-free bypass, and read-only correlation and mono-fit meters. CC 1-4 on the selected channel temporarily override rotation, width, mid and image delay until the panel or host moves that control; read-only outputs report the effective values. No transport or plugin state." ;
    trn:bundleName "splay.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/splay/> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio, trn:MidiCC ;
    trn:produces trn:Audio .

dsp:splay trn:hasParameter [
    trn:symbol "matrixLL" ;
    trn:label "L to L" ;
    trn:minimum 0.0 ; trn:maximum 2.0 ; trn:default 1.0 ;
    rdfs:comment "Left input gain into the left output; 1 is unity"
], [
    trn:symbol "matrixLR" ;
    trn:label "L to R" ;
    trn:minimum 0.0 ; trn:maximum 2.0 ; trn:default 0.0 ;
    rdfs:comment "Left input gain into the right output"
], [
    trn:symbol "matrixRL" ;
    trn:label "R to L" ;
    trn:minimum 0.0 ; trn:maximum 2.0 ; trn:default 0.0 ;
    rdfs:comment "Right input gain into the left output"
], [
    trn:symbol "matrixRR" ;
    trn:label "R to R" ;
    trn:minimum 0.0 ; trn:maximum 2.0 ; trn:default 1.0 ;
    rdfs:comment "Right input gain into the right output; 1 is unity"
], [
    trn:symbol "width" ;
    trn:label "Width" ;
    trn:minimum 0.0 ; trn:maximum 2.0 ; trn:default 1.0 ;
    rdfs:comment "Mid/side side gain: 0 is mono, 1 unchanged, 2 doubles the side"
], [
    trn:symbol "imageDelay" ;
    trn:label "Image Delay" ;
    trn:minimum 0.0 ; trn:maximum 20.0 ; trn:default 0.0 ;
    rdfs:comment "Fractional delay in milliseconds, applied only to the right channel; not reported as host latency"
], [
    trn:symbol "invertR" ;
    trn:label "Invert R" ;
    trn:minimum 0 ; trn:maximum 1 ; trn:default 0 ;
    rdfs:comment "1 inverts the right channel's phase after the image delay"
], [
    trn:symbol "level" ;
    trn:label "Output" ;
    trn:minimum 0.0 ; trn:maximum 2.0 ; trn:default 1.0 ;
    rdfs:comment "Final gain on both outputs"
], [
    trn:symbol "bypass" ;
    trn:label "Bypass" ;
    trn:minimum 0 ; trn:maximum 1 ; trn:default 0 ;
    rdfs:comment "1 crossfades to the untouched stereo input"
], [
    trn:symbol "rotation" ;
    trn:label "Rotation" ;
    trn:minimum -90.0 ; trn:maximum 90.0 ; trn:default 0.0 ;
    rdfs:comment "Stereo rotation in degrees after the matrix; 0 is transparent"
], [
    trn:symbol "pan_law" ;
    trn:label "Pan Law" ;
    trn:minimum 0 ; trn:maximum 1 ; trn:default 0 ;
    rdfs:comment "0 leaves matrix gains alone, 1 applies constant-power compensation where a row or column has more than one active path"
], [
    trn:symbol "mid_gain" ;
    trn:label "Mid" ;
    trn:minimum 0.0 ; trn:maximum 2.0 ; trn:default 1.0 ;
    rdfs:comment "Independent mid gain in the mid/side stage"
], [
    trn:symbol "ms_solo" ;
    trn:label "M/S Solo" ;
    trn:minimum 0 ; trn:maximum 2 ; trn:default 0 ;
    rdfs:comment "0 off, 1 mid only, 2 side only"
], [
    trn:symbol "spectral_width" ;
    trn:label "Spectral Width" ;
    trn:minimum 0 ; trn:maximum 1 ; trn:default 0 ;
    rdfs:comment "1 enables frequency-dependent side gains below and above Crossover"
], [
    trn:symbol "crossover" ;
    trn:label "Crossover" ;
    trn:minimum 100.0 ; trn:maximum 2000.0 ; trn:default 500.0 ;
    rdfs:comment "One-pole low/high split in Hz for Spectral Width"
], [
    trn:symbol "low_width" ;
    trn:label "Low Width" ;
    trn:minimum 0.0 ; trn:maximum 2.0 ; trn:default 1.0 ;
    rdfs:comment "Side-gain factor for the band below Crossover"
], [
    trn:symbol "high_width" ;
    trn:label "High Width" ;
    trn:minimum 0.0 ; trn:maximum 2.0 ; trn:default 1.0 ;
    rdfs:comment "Side-gain factor for the band above Crossover"
], [
    trn:symbol "cc_channel" ;
    trn:label "CC Channel" ;
    trn:minimum 0 ; trn:maximum 16 ; trn:default 1 ;
    rdfs:comment "MIDI channel whose CC 1-4 drive Rotation, Width, Mid and Image Delay; 0 ignores MIDI"
], [
    trn:symbol "out_correlation" ;
    trn:label "Correlation" ;
    trn:minimum -1.0 ; trn:maximum 1.0 ; trn:default 0.0 ;
    rdfs:comment "Read-only: smoothed correlation of the final left and right outputs"
], [
    trn:symbol "out_mono" ;
    trn:label "Mono Fit" ;
    trn:minimum 0.0 ; trn:maximum 1.0 ; trn:default 0.0 ;
    rdfs:comment "Read-only: smoothed mono compatibility of the final outputs"
], [
    trn:symbol "out_cc_rotation" ;
    trn:label "Rotation (CC1)" ;
    trn:minimum -90.0 ; trn:maximum 90.0 ; trn:default 0.0 ;
    rdfs:comment "Read-only: effective rotation in degrees after CC override"
], [
    trn:symbol "out_cc_width" ;
    trn:label "Width (CC2)" ;
    trn:minimum 0.0 ; trn:maximum 2.0 ; trn:default 1.0 ;
    rdfs:comment "Read-only: effective width after CC override"
], [
    trn:symbol "out_cc_mid" ;
    trn:label "Mid (CC3)" ;
    trn:minimum 0.0 ; trn:maximum 2.0 ; trn:default 1.0 ;
    rdfs:comment "Read-only: effective mid gain after CC override"
], [
    trn:symbol "out_cc_delay" ;
    trn:label "Image Delay (CC4)" ;
    trn:minimum 0.0 ; trn:maximum 20.0 ; trn:default 0.0 ;
    rdfs:comment "Read-only: effective right-channel image delay in ms after CC override"
] .
