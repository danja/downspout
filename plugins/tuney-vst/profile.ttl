@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix dsp:  <http://purl.org/stuff/transmissions/plugins/downspout/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

dsp:tuney-vst a trn:PluginProfile ;
    rdfs:label "Tuney VST" ;
    rdfs:comment "Text-to-music instrument and MIDI generator with configurable alphabets, scales, and microtonal tunings." ;
    trn:bundleName "tuney_vst.vst3" ;
    trn:vendor "danja" ;
    foaf:homepage <https://danja.github.io/downspout/plugins/tuney_vst/> ;
    trn:role trn:Instrument, trn:MidiGenerator ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio, trn:Midi, trn:MelodyMidi .
