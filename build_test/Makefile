# Build rule for target.
drumgen-ui: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 drumgen-ui
.PHONY : drumgen-ui

# fast build rule for target.
drumgen-ui/fast:
	$(MAKE) $(MAKESILENT) -f plugins/drumgen/CMakeFiles/drumgen-ui.dir/build.make plugins/drumgen/CMakeFiles/drumgen-ui.dir/build
.PHONY : drumgen-ui/fast

