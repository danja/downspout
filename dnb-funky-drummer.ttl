@prefix : <http://purl.org/stuff/transmissions/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:main a :Transmission ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Transmission" ;
    :tempoMap ( [ :atBeat 0 ; :bpm 174 ] ) ;
    :loopStart 0 ;
    :loopEnd 8 ;
    :loopEnabled true ;
    :systemInputConnections ( "No connection" "No connection" ) ;
    :systemOutputConnections ( "UMC404HD 192k:playback_AUX0" "UMC404HD 192k:playback_AUX1" ) ;
    :audioSettings [ :renderAheadMs 200 ; :requestedBufferSize 0 ; :processingThreads 0 ] ;
    :pipe ( :system-input :system-output :drumgen :campione :bassgen :audio-clip-1 :plugin-1 ) ;
    :connections ( [ :from :drumgen ; :to :campione ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :audio-clip-1 ; :to :plugin-1 ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :audio-clip-1 ; :to :plugin-1 ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :campione ; :to :plugin-1 ; :kind "audio" ; :fromPort 0 ; :toPort 2 ] [ :from :campione ; :to :plugin-1 ; :kind "audio" ; :fromPort 1 ; :toPort 3 ] [ :from :plugin-1 ; :to :system-output ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :plugin-1 ; :to :system-output ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] ) .

:system-input a :AudioInput ;
    <http://www.w3.org/2000/01/rdf-schema#label> "System Input" ;
    :audioOutputs 2 ;
    :midiOutputs 1 ;
    :editorX 60 ;
    :editorY 60 .

:system-output a :AudioOutput ;
    <http://www.w3.org/2000/01/rdf-schema#label> "System Output" ;
    :audioInputs 4 ;
    :midiInputs 1 ;
    :editorX 900 ;
    :editorY 100 .

:drumgen a :VST3Plugin ;
    <http://www.w3.org/2000/01/rdf-schema#label> "DrumGen" ;
    :audioOutputs 2 ;
    :midiInputs 1 ;
    :midiOutputs 1 ;
    :editorX 60 ;
    :editorY 220 ;
    :settings [ :pluginPath "/home/danny/.vst3/drumgen.vst3" ] ;
    :parameters ( [ :parameterId 2085 ; :normalizedValue 1 ] ) ;
    :componentState "" .

:campione a :VST3Plugin ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Campione" ;
    :audioInputs 2 ;
    :audioOutputs 2 ;
    :midiInputs 1 ;
    :editorX 380 ;
    :editorY 220 ;
    :settings [ :pluginPath "/home/danny/.vst3/campione.vst3" ] ;
    :parameters ( [ :parameterId 2083 ; :normalizedValue 0.625 ] ) ;
    :componentState "" .

:bassgen a :VST3Plugin ;
    <http://www.w3.org/2000/01/rdf-schema#label> "BassGen" ;
    :audioOutputs 2 ;
    :midiInputs 1 ;
    :midiOutputs 1 ;
    :editorX 60 ;
    :editorY 380 ;
    :settings [ :pluginPath "/home/danny/.vst3/bassgen.vst3" ] ;
    :componentState "" .

:audio-clip-1 a :AudioClipNode ;
    <http://www.w3.org/2000/01/rdf-schema#label> "amen-break-original_138bpm_G_major" ;
    :audioOutputs 2 ;
    :editorX 331 ;
    :editorY 435 ;
    :settings [ :pluginPath "/home/danny/Music/samples/loops/amen-break-original_138bpm_G_major.wav" ] .

:plugin-1 a :VST3Plugin ;
    <http://www.w3.org/2000/01/rdf-schema#label> "T-Mix" ;
    :audioInputs 8 ;
    :audioOutputs 2 ;
    :midiInputs 1 ;
    :midiOutputs 1 ;
    :editorX 782 ;
    :editorY 272 ;
    :settings [ :pluginPath "/home/danny/.gemini/tmp/downspout/dist/t_mix.vst3" ] ;
    :parameters ( [ :parameterId 2082 ; :normalizedValue 0 ] [ :parameterId 2083 ; :normalizedValue 0 ] [ :parameterId 2084 ; :normalizedValue 0.996711 ] [ :parameterId 2085 ; :normalizedValue 0.868421 ] ) ;
    :componentState "" .
