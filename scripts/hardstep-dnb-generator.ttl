@prefix : <http://purl.org/stuff/transmissions/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:main a :Transmission ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Transmission" ;
    :tempoMap ( [ :atBeat 0 ; :bpm 174 ] ) ;
    :loopStart 0 ;
    :loopEnd 32 ;
    :loopEnabled true ;
    :systemInputConnections ( "No connection" "No connection" ) ;
    :systemOutputConnections ( "UMC404HD 192k-122:playback_AUX0" "UMC404HD 192k-122:playback_AUX1" ) ;
    :audioSettings [ :renderAheadMs 200 ; :requestedBufferSize 0 ; :processingThreads 0 ] ;
    :pipe ( :system-input :drumgen :bassgen :ground :melgen :cadence :campione_drums :campione_bass :campione_mel :drumkit :pmix :gater :rift :t-mix :guardian :system-output ) ;
    :connections ( [ :from :drumgen ; :to :campione_drums ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :drumgen ; :to :drumkit ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :drumgen ; :to :gater ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :bassgen ; :to :campione_bass ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :ground ; :to :campione_bass ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :melgen ; :to :cadence ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :melgen ; :to :campione_mel ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :cadence ; :to :campione_mel ; :kind "midi" ; :fromPort 0 ; :toPort 0 ] [ :from :drumkit ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :drumkit ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :campione_drums ; :to :pmix ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :campione_drums ; :to :pmix ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :pmix ; :to :rift ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :pmix ; :to :rift ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :rift ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 2 ] [ :from :rift ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 3 ] [ :from :campione_bass ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 4 ] [ :from :campione_bass ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 5 ] [ :from :campione_mel ; :to :gater ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :campione_mel ; :to :gater ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :gater ; :to :t-mix ; :kind "audio" ; :fromPort 0 ; :toPort 6 ] [ :from :gater ; :to :t-mix ; :kind "audio" ; :fromPort 1 ; :toPort 7 ] [ :from :t-mix ; :to :guardian ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :t-mix ; :to :guardian ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 0 ; :toPort 0 ] [ :from :guardian ; :to :system-output ; :kind "audio" ; :fromPort 1 ; :toPort 1 ] ) .

:system-input a :AudioInput ;
    <http://www.w3.org/2000/01/rdf-schema#label> "System Input" ;
    :audioOutputs 2 ;
    :midiOutputs 1 ;
    :editorX 40 ;
    :editorY 80 .

